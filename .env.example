# Required for the eval and the LLM path
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile    # verify the current tool-calling model on console.groq.com
# Optional fallback LLM
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite    # verify on aistudio.google.com
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=gemini          # groq | gemini | none
DATABASE_URL=postgresql://voice:voice@localhost:5432/voice
