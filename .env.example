# Required for the eval and the LLM path
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b        # verify the current tool-calling model on console.groq.com
# Optional fallback LLM
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite    # verify on aistudio.google.com
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=gemini          # groq | gemini | none
DATABASE_URL=postgresql://voice:voice@localhost:5433/voice

# Voice (Plan 2). Groq key above also powers English STT.
GROQ_COMPOSE_MODEL=                   # optional: composer on its own model / token bucket (N6)
LLM_REASONING_EFFORT=low
GROQ_STT_MODEL=whisper-large-v3
SARVAM_API_KEY=                       # optional: Hinglish STT (falls back to Groq Whisper)
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=translit
ELEVENLABS_API_KEY=                   # optional: server TTS (falls back to browser speech)
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_flash_v2_5
TTS_MODE=sentence                     # sentence | whole (J5 comparison)
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
